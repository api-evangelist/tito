{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tito Admin Account API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Confirm authentication",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tito.io/v3/hello"
          },
          "docs": "Confirms the API token is valid and lists the accounts it can access."
        }
      ]
    }
  ],
  "bundled": true
}