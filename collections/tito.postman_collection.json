{
  "info": {
    "name": "Tito Admin API",
    "description": "REST/JSON interface for managing Tito events, releases, tickets, registrations, discount codes, activities, check-in lists, refunds, and webhook endpoints. Base URL: https://api.tito.io/v3. Authenticate with a secret API token (from https://id.tito.io/api-access-tokens) sent as 'Authorization: Token token=YOUR-API-TOKEN' plus 'Accept: application/json'. Paths and methods are grounded in the Tito Admin API v3.0 docs; request bodies are modeled examples.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "in", "value": "header", "type": "string" },
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "value", "value": "Token token={{apiToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api.tito.io/v3", "type": "string" },
    { "key": "apiToken", "value": "", "type": "string" },
    { "key": "account_slug", "value": "", "type": "string" },
    { "key": "event_slug", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Confirm authentication",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/hello", "host": ["{{baseUrl}}"], "path": ["hello"] },
            "description": "Confirms the API token is valid and lists accessible accounts."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Get all upcoming events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/events", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "events"] }
          }
        },
        {
          "name": "Get all past events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/events/past", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "events", "past"] }
          }
        },
        {
          "name": "Get all archived events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/events/archived", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "events", "archived"] }
          }
        },
        {
          "name": "Get an event",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/{{event_slug}}", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "{{event_slug}}"] }
          }
        },
        {
          "name": "Create an event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event\": {\n    \"title\": \"Awesome Conf\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/events", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "events"] }
          }
        },
        {
          "name": "Update an event",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"event\": {\n    \"location\": \"Dublin, Ireland\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/{{event_slug}}", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "{{event_slug}}"] }
          }
        },
        {
          "name": "Delete an event",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/{{event_slug}}", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "{{event_slug}}"] }
          }
        },
        {
          "name": "Duplicate an event",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/{{event_slug}}/duplication", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "{{event_slug}}", "duplication"] }
          }
        },
        {
          "name": "Get event duplication status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/{{account_slug}}/{{event_slug}}/duplication", "host": ["{{baseUrl}}"], "path": ["{{account_slug}}", "{{event_slug}}", "duplication"] }
          }
        }
      ]
    },
